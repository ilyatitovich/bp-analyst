{
  "name": "bp-analyst",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter @bp-analyst/extension dev",
    "dev:chrome": "pnpm --filter @bp-analyst/extension dev:chrome",
    "dev:website": "pnpm --filter @bp-analyst/website dev",
    "build": "pnpm --filter @bp-analyst/extension build",
    "build:chrome": "pnpm --filter @bp-analyst/extension build:chrome",
    "build:website": "pnpm --filter @bp-analyst/website build",
    "zip": "pnpm --filter @bp-analyst/extension zip",
    "zip:chrome": "pnpm --filter @bp-analyst/extension zip:chrome",
    "dev:firefox": "pnpm --filter @bp-analyst/extension dev:firefox",
    "build:firefox": "pnpm --filter @bp-analyst/extension build:firefox",
    "zip:firefox": "pnpm --filter @bp-analyst/extension zip:firefox",
    "typecheck": "pnpm --filter @bp-analyst/extension typecheck",
    "typecheck:website": "pnpm --filter @bp-analyst/website typecheck",
    "lint": "pnpm --filter @bp-analyst/extension lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "pnpm --filter @bp-analyst/extension knip",
    "test": "pnpm --filter @bp-analyst/extension test",
    "test:e2e": "pnpm --filter @bp-analyst/extension test:e2e",
    "bench:extract": "pnpm --filter @bp-analyst/extension bench:extract",
    "prepare": "husky"
  },
  "license": "ISC",
  "lint-staged": {
    "apps/extension/**/*.{js,mjs,cjs,jsx,ts,tsx}": [
      "pnpm --filter @bp-analyst/extension exec eslint --fix",
      "prettier --write"
    ],
    "apps/website/**/*.{astro,css,ts,mjs,js}": [
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
