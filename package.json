{
  "name": "bp-analyst",
  "version": "0.1.0",
  "description": "Beatport Analyst Chromium extension for producer-facing track analysis and CSV export.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "wxt -b edge",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b edge",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b edge",
    "zip:chrome": "wxt zip -b chrome",
    "dev:firefox": "wxt -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bench:extract": "vitest run --config vitest.bench.config.ts --pool=threads",
    "prepare": "husky"
  },
  "keywords": [
    "firefox-extension",
    "edge-extension",
    "chrome-extension",
    "beatport",
    "music",
    "analysis",
    "wxt"
  ],
  "license": "ISC",
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
