{
  "name": "bp-analyst",
  "version": "0.1.0",
  "description": "Beatport Analyst Chromium extension for producer-facing track analysis and CSV export.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "wxt -b edge",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b edge",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b edge",
    "zip:chrome": "wxt zip -b chrome",
    "dev:firefox": "wxt -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "test": "vitest run"
  },
  "keywords": [
    "firefox-extension",
    "edge-extension",
    "chrome-extension",
    "beatport",
    "music",
    "analysis",
    "wxt"
  ],
  "license": "ISC",
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
