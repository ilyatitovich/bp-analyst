---
import SectionIntro from './SectionIntro.astro'

const benefits = [
  {
    title: 'Market brief on the list you opened',
    body: 'Exclusive and hype share, freshness, BPM spread, key concentration, and top labels — from the Beatport chart or search you already have on screen.'
  },
  {
    title: 'Local-only analysis',
    body: 'Track data stays in your browser session. Nothing is sent to a backend, and closing the browser clears the live snapshot.'
  },
  {
    title: 'No Beatport account required',
    body: 'No partner API, no login, no crawl of other charts. It only reads the list you opened.'
  }
]
---

<section class="benefits" id="benefits" aria-labelledby="benefits-title">
  <SectionIntro
    titleId="benefits-title"
    title="Built for market reconnaissance"
    lede="For producers scanning a chart — not crate digging, not harmonic mixing."
  />
  <ul class="benefits__list">
    {benefits.map(benefit => (
      <li class="benefits__item reveal">
        <h3 class="benefits__item-title">{benefit.title}</h3>
        <p class="benefits__item-body">{benefit.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  @layer components {
    .benefits__list {
      display: grid;
      gap: var(--space-6);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @media (min-width: 48rem) {
      .benefits__list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-7);
      }
    }

    .benefits__item {
      display: grid;
      gap: var(--space-3);
      align-content: start;
      padding-block-start: var(--space-4);
      border-block-start: 1px solid var(--ui-border);
    }

    .benefits__item-title {
      margin: 0;
      font-size: var(--text-lg);
    }

    .benefits__item-body {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--color-fg-muted);
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports ((animation-timeline: view()) and (animation-range: entry)) {
        @keyframes reveal-in {
          from {
            opacity: 0;
            translate: 0 0.85rem;
          }
        }

        .reveal {
          animation: reveal-in auto linear both;
          animation-timeline: view();
          animation-range: entry 0% entry 40%;
        }
      }
    }
  }
</style>
