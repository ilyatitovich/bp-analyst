---
import SectionIntro from './SectionIntro.astro'

const benefits = [
  {
    title: 'Brief the list in front of you',
    body: 'Exclusive and hype share, freshness, BPM spread, key concentration, top labels and artists — from the Beatport page you already loaded.'
  },
  {
    title: 'Stays in your browser',
    body: 'Track data never leaves the session. No backend. Close the browser and the live snapshot is gone.'
  },
  {
    title: 'No account. No crawl.',
    body: 'No Beatport partner API, no login, no scraping other charts. It only reads the list you opened.'
  }
]
---

<section class="benefits" id="benefits" aria-labelledby="benefits-title">
  <SectionIntro
    titleId="benefits-title"
    title="Built for reading the market"
    lede="Not a dig tool. Not a mixing helper. A reconnaissance pass over the list you opened."
  />
  <ul class="benefits__list">
    {benefits.map(benefit => (
      <li class="benefits__item reveal">
        <h3 class="benefits__item-title">{benefit.title}</h3>
        <p class="benefits__item-body">{benefit.body}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  @layer components {
    .benefits {
      display: grid;
      align-content: center;
      min-block-size: 100dvh;
      padding-block: var(--space-7) var(--space-8);
    }

    .benefits__list {
      display: grid;
      gap: var(--space-6);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @media (min-width: 48rem) {
      .benefits__list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .benefits__item {
      display: grid;
      gap: var(--space-2);
      align-content: start;
      padding-block: var(--space-5);
      border-block-start: 1px solid var(--ui-border);
    }

    .benefits__item-title {
      margin: 0;
      font-size: var(--text-lg);
    }

    .benefits__item-body {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--color-fg-muted);
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports ((animation-timeline: view()) and (animation-range: entry)) {
        @keyframes reveal-in {
          from {
            opacity: 0;
            translate: 0 0.85rem;
          }
        }

        .reveal {
          animation: reveal-in auto linear both;
          animation-timeline: view();
          animation-range: entry 0% entry 40%;
        }
      }
    }
  }
</style>
