---
import {
  BROWSERS,
  DOWNLOAD_URLS,
  GITHUB_README_URL,
  getInstallCtaLabel
} from '../data/downloads'
import Cta from './Cta.astro'
import SectionIntro from './SectionIntro.astro'

const defaultBrowser = BROWSERS[0]
---

<section
  class="download"
  id="download"
  aria-labelledby={`download-title-${defaultBrowser.id}`}
  data-download
>
  {BROWSERS.map(browser => {
    const isDefault = browser.id === defaultBrowser.id
    const isStore = browser.method === 'store'
    const titleId = `download-title-${browser.id}`

    return (
      <div
        class="download__variant"
        data-browser={browser.id}
        hidden={!isDefault}
      >
        {isStore ? (
          <SectionIntro
            titleId={titleId}
            title="Get the extension"
            lede={`BP Analyst is on the ${browser.label} store. Install in one click — no zip, no unpacked load.`}
          />
        ) : (
          <SectionIntro
            titleId={titleId}
            title="Get the Chrome build"
            lede="Chrome isn’t on the Web Store yet. Download the zip and load it unpacked."
          />
        )}

        <div class="download__panel">
          <p class="download__cta-row">
            <Cta
              class="download__cta"
              href={DOWNLOAD_URLS[browser.id]}
              rel={isStore ? 'noopener noreferrer' : undefined}
              data-browser={browser.id}
            >
              {getInstallCtaLabel(browser.id)}
            </Cta>
          </p>

          {isStore ? (
            <p class="download__note">
              Opens the official {browser.label} listing. After install, open
              any Beatport track list and click the toolbar icon.
            </p>
          ) : (
            <p class="download__note">
              Unzip the archive, then load it unpacked from{' '}
              <code>chrome://extensions</code>. Step-by-step instructions are in
              the{' '}
              <a href={GITHUB_README_URL} rel="noopener noreferrer">
                GitHub README
              </a>
              .
            </p>
          )}
        </div>
      </div>
    )
  })}
</section>

<script>
  import { detectPreferredBrowser } from '../scripts/detect-browser'
  import {
    DOWNLOAD_URLS,
    getBrowser,
    getInstallCtaLabel
  } from '../data/downloads'

  const preferred = detectPreferredBrowser()
  const browser = getBrowser(preferred)
  const root = document.querySelector<HTMLElement>('[data-download]')
  const heroLink = document.querySelector<HTMLAnchorElement>(
    '[data-hero-download]'
  )

  if (root) {
    for (const variant of root.querySelectorAll<HTMLElement>(
      '.download__variant'
    )) {
      const isMatch = variant.dataset.browser === preferred
      variant.hidden = !isMatch
    }
    root.setAttribute('aria-labelledby', `download-title-${preferred}`)
  }

  if (heroLink) {
    heroLink.dataset.browser = preferred
    heroLink.href = DOWNLOAD_URLS[preferred]
    heroLink.textContent = getInstallCtaLabel(preferred)
    if (browser.method === 'store') {
      heroLink.rel = 'noopener noreferrer'
    } else {
      heroLink.removeAttribute('rel')
    }
  }
</script>

<style>
  @layer components {
    .download {
      display: grid;
      align-content: center;
      min-block-size: 100dvh;
      padding-block: var(--space-7) var(--space-8);
    }

    .download__variant[hidden] {
      display: none;
    }

    .download__panel {
      display: grid;
      gap: var(--space-6);
      max-inline-size: 40rem;
    }

    .download__cta-row {
      margin: 0;
    }

    .download__cta-row :global(.download__cta) {
      min-inline-size: 11.5rem;
    }

    .download__note {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--color-fg-subtle);
      max-inline-size: 48ch;
    }

    .download__note code {
      font-size: 0.92em;
      color: var(--color-fg-muted);
    }

    .download__note a {
      color: var(--color-accent-alt);
      text-decoration-thickness: 0.08em;
      text-underline-offset: 0.18em;
    }

    .download__note a:hover {
      color: var(--color-accent);
    }
  }
</style>
