---
import { BROWSERS, DOWNLOAD_URLS, getInstallCtaLabel } from '../data/downloads'
import Cta from './Cta.astro'

const primary = BROWSERS[0]
---

<section class="hero" aria-labelledby="hero-brand">
  <div class="hero__content">
    <h1 id="hero-brand" class="hero__brand" tabindex="-1">
      Beatport Analyst
    </h1>
    <p class="hero__headline">Turn any Beatport list into a market brief.</p>
    <p class="hero__lede">
      Open a chart, genre page, search, or release. The side panel shows the
      shape of what’s on it — BPM, key, labels, exclusives, freshness.
    </p>
    <p class="hero__cta-row">
      <Cta
        href={DOWNLOAD_URLS[primary.id]}
        data-hero-download
        data-browser={primary.id}
      >
        {getInstallCtaLabel(primary.id)}
      </Cta>
    </p>
  </div>
</section>

<style>
  @layer components {
    .hero {
      display: grid;
      place-content: center;
      justify-items: center;
      min-block-size: 100dvh;
      padding-block: var(--space-7) var(--space-8);
      text-align: center;
    }

    .hero__content {
      display: grid;
      gap: var(--space-3);
      justify-items: center;
    }

    .hero__brand {
      margin: 0;
    }

    .hero__headline {
      margin: 0;
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      font-weight: 600;
      line-height: var(--leading-snug);
      letter-spacing: -0.02em;
      color: var(--color-fg);
      text-wrap: balance;
    }

    .hero__lede {
      margin: 0;
      font-size: var(--text-lg);
      color: var(--color-fg-muted);
      max-inline-size: 42ch;
    }

    .hero__cta-row {
      margin-block-start: var(--space-3);
    }

    @media (prefers-reduced-motion: no-preference) {
      .hero__content {
        animation: hero-rise var(--duration-med) var(--ease-out) both;
      }

      .hero__logo {
        animation: hero-glow 4.5s var(--ease-out) infinite alternate;
      }
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        translate: 0 0.85rem;
      }

      to {
        opacity: 1;
        translate: 0 0;
      }
    }

    @keyframes hero-glow {
      from {
        filter: drop-shadow(0 0 1.25rem var(--surface-glow));
      }

      to {
        filter: drop-shadow(
          0 0 2.4rem color-mix(in oklab, var(--color-mint-400) 28%, transparent)
        );
      }
    }
  }
</style>
