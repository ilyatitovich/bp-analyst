---
import SectionIntro from './SectionIntro.astro'

const features = [
  {
    title: 'Market brief',
    body: 'Exclusives, hype, tracks from the last 7 / 30 days, BPM median and IQR, key concentration, top labels and artists, mix types, and length bands.'
  },
  {
    title: 'Charts and filters',
    body: 'BPM histogram, Camelot or scale-key breakdown, genre / label / artist views. Click a bucket to filter the list.'
  },
  {
    title: 'Track table and preview',
    body: 'Search by title, mix, or artist; Exclusive and Hype chips; sortable columns; in-panel audio preview from Beatport’s own samples.'
  },
  {
    title: 'CSV export',
    body: 'Export the currently visible (filtered) tracks when you want a copy of what’s on screen.'
  }
]
---

<section class="features" id="features" aria-labelledby="features-title">
  <SectionIntro
    titleId="features-title"
    title="What you get in the side panel"
    lede="Open a Beatport list, click the toolbar icon, and work from one snapshot."
  />
  <ol class="features__list">
    {features.map((feature, index) => (
      <li class="features__item reveal">
        <span class="features__index" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class="features__copy">
          <h3 class="features__item-title">{feature.title}</h3>
          <p class="features__item-body">{feature.body}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  @layer components {
    .features__list {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      counter-reset: none;
    }

    .features__item {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--space-4) var(--space-5);
      padding-block: var(--space-5);
      border-block-start: 1px solid var(--ui-border);
    }

    .features__item:last-child {
      border-block-end: 1px solid var(--ui-border);
    }

    .features__index {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--color-accent-alt);
      line-height: 1;
      padding-block-start: 0.2rem;
    }

    .features__copy {
      display: grid;
      gap: var(--space-2);
    }

    .features__item-title {
      margin: 0;
      font-size: var(--text-lg);
    }

    .features__item-body {
      margin: 0;
      font-size: var(--text-sm);
      color: var(--color-fg-muted);
      max-inline-size: 52ch;
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports ((animation-timeline: view()) and (animation-range: entry)) {
        @keyframes reveal-in {
          from {
            opacity: 0;
            translate: 0 0.85rem;
          }
        }

        .reveal {
          animation: reveal-in auto linear both;
          animation-timeline: view();
          animation-range: entry 0% entry 40%;
        }
      }
    }
  }
</style>
