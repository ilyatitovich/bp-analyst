---
import { GITHUB_REPO_URL } from '../data/downloads'
import GitHub from './icons/GitHub.astro'
---

<header class="page__header">
  <div class="page__header-inner">
    <a class="page__brand" href="/">
      <img
        class="page__brand-mark"
        src="/icon.svg"
        alt=""
        width="36"
        height="36"
        decoding="async"
      />
      <span class="page__brand-title">Beatport Analyst</span>
    </a>
    <nav class="page__nav" aria-label="Page sections">
      <a class="page__nav-link" href="#benefits">
        Benefits
      </a>
      <a class="page__nav-link" href="#features">
        Features
      </a>
      <a class="page__nav-link" href="#download">
        Download
      </a>
      <a
        class="page__nav-link page__nav-link--icon"
        href={GITHUB_REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
      >
        <GitHub />
      </a>
    </nav>
  </div>
</header>

<style>
  @layer components {
    .page__header {
      position: fixed;
      inset-block-start: 0;
      inset-inline-start: 0;
      z-index: 100;
      inline-size: 100%;
      padding-block: var(--space-4);
      padding-inline: var(--space-4);
    }

    .page__header-inner {
      display: flex;
      align-items: safe center;
      justify-content: space-between;
      gap: var(--space-4);
      max-inline-size: var(--content-max);
      margin-inline: auto;
      padding-block: var(--space-3);
      padding-inline: var(--space-4);
      border-radius: var(--radius-lg);
      border: 1px solid var(--ui-border);
      background: color-mix(in oklab, var(--color-ink-900) 92%, transparent);
      box-shadow: var(--shadow-soft);
    }

    .page__brand {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      color: var(--color-fg);
      text-decoration: none;
      font-family: var(--font-heading);
      font-weight: 700;
      font-size: var(--text-lg);
      letter-spacing: -0.02em;
    }

    .page__brand-title {
      display: none;
      font-size: var(--text-lg);
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    @media (min-width: 48rem) {
      .page__brand-title {
        display: block;
      }
    }

    .page__brand-mark {
      inline-size: 2.25rem;
      block-size: 2.25rem;
      border-radius: var(--radius-sm);
      flex-shrink: 0;
    }

    .page__nav {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
    }

    .page__nav-link {
      color: var(--color-fg-muted);
      text-decoration: none;
      font-size: var(--text-sm);
      font-weight: 500;
    }

    .page__nav-link:hover {
      color: var(--color-fg);
    }

    .page__nav-link--icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-1);
      margin-block: calc(var(--space-1) * -1);
    }

    .page__nav-icon {
      display: block;
      flex: none;
      pointer-events: none;
    }
  }
</style>
