---
import { Font } from 'astro:assets'
import CookieConsent from '../components/CookieConsent.astro'
import {
  DOWNLOAD_URLS,
  GITHUB_REPO_URL,
  SUPPORT_EMAIL
} from '../data/downloads'
import '../styles/tokens.css'
import '../styles/base.css'
import Header from '../components/Header.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'BP Analyst — market briefs for Beatport',
  description = 'Turn any Beatport chart, search, or release into a side-panel market brief. BPM, key, labels, exclusives, and freshness — local analysis, no account.'
} = Astro.props

const site = Astro.site ?? new URL('https://bp-analyst.vercel.app')
const canonicalURL = new URL(Astro.url.pathname, site)
const ogImageURL = new URL('/logo.png', site)
const pageTitle = title
const analyticsConfigured = Boolean(
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ||
  import.meta.env.PUBLIC_YANDEX_METRIKA_ID?.trim()
)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'BP Analyst',
  'applicationCategory': 'BrowserApplication',
  'operatingSystem': 'Chrome, Edge, Firefox',
  description,
  'url': canonicalURL.href,
  'downloadUrl': new URL(DOWNLOAD_URLS.chrome, site).href,
  'image': ogImageURL.href,
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'USD'
  },
  'author': {
    '@type': 'Person',
    'name': 'Ilya Titov',
    'url': GITHUB_REPO_URL
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#07090d" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BP Analyst" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {' '}
      Skip to main content{' '}
    </a>
    <div class="page">
      <Header />

      <main class="page__main" id="content">
        <div class="page__main-inner">
          <slot />
        </div>
      </main>

      <footer class="page__footer">
        <div class="page__footer-inner">
          <div class="page__footer-copy">
            <p class="page__footer-tagline">
              BP Analyst — market reconnaissance for producers on Beatport.
            </p>
            <p class="page__footer-disclaimer">
              Independent project. Not affiliated with, endorsed by, or
              sponsored by Beatport or The Beatport Group LLC. Beatport® is a
              trademark of its respective owner.
            </p>
          </div>
          <ul class="page__footer-links">
            <li>
              <a
                class="page__footer-link"
                href={GITHUB_REPO_URL}
                rel="noopener noreferrer"
              >
                GitHub
              </a>
            </li>
            <li>
              <a class="page__footer-link" href="/privacy">
                Privacy
              </a>
            </li>
            <li>
              <a class="page__footer-link" href="/cookies">
                Cookies
              </a>
            </li>
            <li>
              <a class="page__footer-link" href="/terms">
                Terms
              </a>
            </li>
            {analyticsConfigured ? (
              <li>
                <a class="page__footer-link" href="#consent" data-open-consent>
                  Cookie settings
                </a>
              </li>
            ) : null}
            <li>
              <a class="page__footer-link" href={`mailto:${SUPPORT_EMAIL}`}>
                Contact
              </a>
            </li>
          </ul>
        </div>
      </footer>
    </div>
    <CookieConsent />
  </body>
</html>

<style>
  @layer components {
    .visually-hidden:not(:focus):not(:active):not(:focus-within) {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .skip-link {
      position: absolute;
      inset-block-start: var(--space-3);
      inset-inline-start: var(--space-3);
      z-index: 100;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
      background: var(--color-bg-elevated);
      color: var(--color-fg);
      border: 1px solid var(--ui-border-strong);
      text-decoration: none;
      font-weight: 600;
      transform: translateY(-150%);
      transition: transform var(--duration-fast) var(--ease-out);

      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }

    .skip-link:focus {
      transform: translateY(0);
    }

    .page {
      display: flex;
      flex-direction: column;
      min-block-size: 100dvh;
    }

    .page__main {
      flex: 1;
      padding-inline: var(--space-5);
    }

    .page__main-inner {
      display: grid;
      max-inline-size: var(--content-max);
      margin-inline: auto;
    }

    .page__footer {
      margin-block-start: auto;
      padding-block: var(--space-6);
      padding-inline: var(--space-5);
      border-block-start: 1px solid var(--ui-border);
    }

    .page__footer-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      max-inline-size: var(--content-max);
      margin-inline: auto;
      font-size: var(--text-sm);
      color: var(--color-fg-subtle);
    }

    .page__footer-copy {
      display: grid;
      gap: var(--space-2);
      max-inline-size: 48ch;
    }

    .page__footer-tagline {
      margin: 0;
      color: var(--color-fg-subtle);
    }

    .page__footer-disclaimer {
      margin: 0;
      font-size: var(--text-xs);
      line-height: var(--leading-normal);
      color: var(--color-fg-subtle);
    }

    .page__footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .page__footer-link {
      color: var(--color-fg-muted);
      text-decoration: none;
    }

    .page__footer-link:hover {
      color: var(--color-accent);
    }
  }
</style>
