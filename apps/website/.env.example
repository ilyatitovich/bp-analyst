# Optional analytics — leave empty to skip injection entirely.
# PUBLIC_GA_MEASUREMENT_ID: GA4 (G-…) or Google tag / GTM (GTM-…).
#   Loads in <head> under Consent Mode (storage denied until Accept).
# PUBLIC_YANDEX_METRIKA_ID: loads only after Accept.
# Set these in the Vercel project when ready.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_YANDEX_METRIKA_ID=
